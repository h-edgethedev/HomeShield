# HomeShield Configuration

# Port for the HomeShield DNS Server to listen on (Default: 53)
# Note: Binding to port 53 requires administrator/root privileges
PORT=53

# Upstream DNS Resolver for allowed queries
# Examples:
#   Google:     8.8.8.8 or 8.8.4.4
#   Cloudflare: 1.1.1.1 or 1.0.0.1
#   Quad9:      9.9.9.9
UPSTREAM_DNS=8.8.8.8
UPSTREAM_PORT=53

